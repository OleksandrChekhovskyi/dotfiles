# Interactive settings shared by Bash, FreeBSD sh, and OpenBSD ksh.
case $(uname -s) in
    Linux)
        alias ls='ls --color=auto'
        alias grep='grep --color=auto'
        ;;
    Darwin)
        alias ls='ls -G'
        alias grep='grep --color=auto'
        ;;
    FreeBSD)
        alias ls='ls --color=auto'
        alias grep='grep --color=auto'
        if [ -z "${BASH_VERSION-}" ]; then
            HISTSIZE=10000
        fi
        ;;
    OpenBSD)
        if [ -z "${BASH_VERSION-}" ]; then
            HISTFILE=$HOME/.ksh_history
            HISTSIZE=10000
            HISTCONTROL=ignoredups:ignorespace
        fi
        ;;
esac

# Per-machine override: export DOTFILES_PROMPT_HOST_COLOR='1;31' in ~/.profile.local.
prompt_host_color=${DOTFILES_PROMPT_HOST_COLOR:-"1;37"}
PS1='\[\e[1;37m\][\[\e['"$prompt_host_color"'m\]\u@\h \[\e[1;33m\]\w\[\e[1;37m\]]\$\[\e[0m\] '
unset prompt_host_color
