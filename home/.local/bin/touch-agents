#!/usr/bin/env bash
set -u

# Invoke Claude Code and/or Codex once with tiny prompts and low-cost settings.
# Useful for starting 5h usage limit windows.
# Usage: ./touch-agents [both|claude|codex]

agent="${1:-both}"
prompt="${PROMPT:-Reply with OK only.}"
claude_model="${CLAUDE_MODEL:-haiku}"
# Hardcode the cheapest known codex slug. Override via CODEX_MODEL when this
# gets renamed (run `codex debug models` to see the current catalog).
codex_model="${CODEX_MODEL:-gpt-5.4-mini}"

run_claude() {
  if ! command -v claude >/dev/null 2>&1; then
    printf 'claude: command not found\n' >&2
    return 127
  fi

  budget_args=()
  if [ -n "${CLAUDE_MAX_BUDGET_USD:-}" ]; then
    budget_args=(--max-budget-usd "$CLAUDE_MAX_BUDGET_USD")
  fi

  printf 'claude: model=%s prompt="%s"\n' "$claude_model" "$prompt" >&2
  # Note: --bare would strip the system prompt further, but it forces auth via
  # ANTHROPIC_API_KEY/apiKeyHelper only — it bypasses keychain/OAuth, which
  # breaks the common login setup. Stick with --system-prompt "" instead.
  out="$(claude \
    --print \
    --model "$claude_model" \
    --effort low \
    --system-prompt "" \
    --tools "" \
    --disable-slash-commands \
    --no-session-persistence \
    --strict-mcp-config \
    --output-format json \
    "${budget_args[@]}" \
    "$prompt")" || return $?

  if command -v jq >/dev/null 2>&1; then
    printf '%s\n' "$out" | jq -r '.result // empty'
    printf '%s\n' "$out" | jq -r '"claude usage: input=\(.usage.input_tokens // 0) output=\(.usage.output_tokens // 0) cost_usd=\(.total_cost_usd // 0)"' >&2
  else
    printf '%s\n' "$out"
    printf 'claude usage: jq not installed; raw json above\n' >&2
  fi
}

run_codex() {
  if ! command -v codex >/dev/null 2>&1; then
    printf 'codex: command not found\n' >&2
    return 127
  fi

  last_message="$(mktemp "${TMPDIR:-/tmp}/touch-codex-message.XXXXXX")" || return 1
  run_log="$(mktemp "${TMPDIR:-/tmp}/touch-codex-log.XXXXXX")" || {
    rm -f "$last_message"
    return 1
  }

  printf 'codex: model=%s prompt="%s"\n' "$codex_model" "$prompt" >&2
  if codex exec \
    --model "$codex_model" \
    --skip-git-repo-check \
    --ephemeral \
    --ignore-user-config \
    --ignore-rules \
    --sandbox read-only \
    --color never \
    --json \
    -c 'model_reasoning_effort="low"' \
    -c 'model_verbosity="low"' \
    -c 'model_reasoning_summary="none"' \
    -c 'shell_environment_policy.inherit="none"' \
    -c 'instructions=""' \
    -c 'base_instructions=""' \
    -c 'include_apply_patch_tool=false' \
    -c 'mcp_servers={}' \
    --output-last-message "$last_message" \
    "$prompt" >"$run_log" 2>&1; then
    if [ -s "$last_message" ]; then
      cat "$last_message"
      [ "$(tail -c 1 "$last_message")" = "" ] || printf '\n'
    fi
    if command -v jq >/dev/null 2>&1; then
      grep '"type":"turn.completed"' "$run_log" | tail -1 | \
        jq -r '"codex usage: input=\(.usage.input_tokens // 0) cached=\(.usage.cached_input_tokens // 0) output=\(.usage.output_tokens // 0) reasoning=\(.usage.reasoning_output_tokens // 0)"' >&2
    else
      printf 'codex usage: jq not installed\n' >&2
    fi
    rm -f "$last_message" "$run_log"
    return 0
  fi

  status=$?
  printf 'codex failed (exit %s)\n' "$status" >&2
  sed -n '1,80p' "$run_log" >&2
  rm -f "$last_message" "$run_log"
  return "$status"
}

case "$agent" in
  both)
    status=0
    run_claude || status=$?
    run_codex || status=$?
    exit "$status"
    ;;
  claude)
    run_claude
    ;;
  codex)
    run_codex
    ;;
  *)
    printf 'usage: %s [both|claude|codex]\n' "$0" >&2
    exit 2
    ;;
esac
