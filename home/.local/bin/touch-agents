#!/bin/sh
set -u

# Invoke Claude Code and/or Codex once with tiny prompts and low-cost settings.
# Useful for starting 5h usage limit windows.
# Usage: ./touch-agents [both|claude|codex]

agent=${1:-both}
claude_prompt=${CLAUDE_PROMPT:-${PROMPT:-Reply with OK only.}}
codex_nonce=${CODEX_NONCE:-$(date +%s)-$$}
default_codex_prompt='In exactly 50 words, say this harmless subscription-window touch '
default_codex_prompt="${default_codex_prompt}succeeded. Include nonce $codex_nonce."
codex_prompt=${CODEX_PROMPT:-${PROMPT:-$default_codex_prompt}}
unset default_codex_prompt
claude_model=${CLAUDE_MODEL:-haiku}
# Use a regular Codex model by default; tiny/mini turns can be too small to
# durably move subscription windows. Override via CODEX_MODEL if needed.
codex_model=${CODEX_MODEL:-gpt-5.5}

run_claude() {
  if ! command -v claude >/dev/null 2>&1; then
    printf 'claude: command not found\n' >&2
    return 127
  fi

  set --
  if [ -n "${CLAUDE_MAX_BUDGET_USD:-}" ]; then
    set -- --max-budget-usd "$CLAUDE_MAX_BUDGET_USD"
  fi

  printf 'claude: model=%s prompt="%s"\n' "$claude_model" "$claude_prompt" >&2
  # Note: --bare would strip the system prompt further, but it forces auth via
  # ANTHROPIC_API_KEY/apiKeyHelper only — it bypasses keychain/OAuth, which
  # breaks the common login setup. Stick with --system-prompt "" instead.
  out=$(env -u ANTHROPIC_API_KEY -u ANTHROPIC_AUTH_TOKEN claude \
    --print \
    --model "$claude_model" \
    --effort low \
    --system-prompt "" \
    --tools "" \
    --disable-slash-commands \
    --no-session-persistence \
    --strict-mcp-config \
    --output-format json \
    "$@" \
    "$claude_prompt") || return $?

  if command -v jq >/dev/null 2>&1; then
    printf '%s\n' "$out" | jq -r '.result // empty'
    printf '%s\n' "$out" | jq -r '
      "claude usage: input=\(.usage.input_tokens // 0) " +
      "output=\(.usage.output_tokens // 0) " +
      "cost_usd=\(.total_cost_usd // 0)"
    ' >&2
  else
    printf '%s\n' "$out"
    printf 'claude usage: jq not installed; raw json above\n' >&2
  fi
}

run_codex() {
  if ! command -v codex >/dev/null 2>&1; then
    printf 'codex: command not found\n' >&2
    return 127
  fi

  last_message=$(mktemp "${TMPDIR:-/tmp}/touch-codex-message.XXXXXX") || return 1
  run_log=$(mktemp "${TMPDIR:-/tmp}/touch-codex-log.XXXXXX") || {
    rm -f "$last_message"
    return 1
  }

  set -- --ephemeral
  if [ "${CODEX_EPHEMERAL:-1}" = 0 ]; then
    set --
  fi

  printf 'codex: model=%s prompt="%s"\n' "$codex_model" "$codex_prompt" >&2
  if env -u CODEX_API_KEY -u OPENAI_API_KEY codex exec \
    --model "$codex_model" \
    --skip-git-repo-check \
    "$@" \
    --ignore-user-config \
    --ignore-rules \
    --sandbox read-only \
    --color never \
    --json \
    -c 'model_reasoning_effort="low"' \
    -c 'model_verbosity="low"' \
    -c 'model_reasoning_summary="none"' \
    -c 'shell_environment_policy.inherit="none"' \
    -c 'instructions="."' \
    -c 'include_apply_patch_tool=false' \
    -c 'mcp_servers={}' \
    --output-last-message "$last_message" \
    "$codex_prompt" >"$run_log" 2>&1; then
    if [ -s "$last_message" ]; then
      cat "$last_message"
      [ "$(tail -c 1 "$last_message")" = "" ] || printf '\n'
    fi
    if command -v jq >/dev/null 2>&1; then
      grep '"type":"turn.completed"' "$run_log" | tail -1 | \
        jq -r '
          "codex usage: input=\(.usage.input_tokens // 0) " +
          "cached=\(.usage.cached_input_tokens // 0) " +
          "output=\(.usage.output_tokens // 0) " +
          "reasoning=\(.usage.reasoning_output_tokens // 0)"
        ' >&2
    else
      printf 'codex usage: jq not installed\n' >&2
    fi
    rm -f "$last_message" "$run_log"
    return 0
  fi

  status=$?
  printf 'codex failed (exit %s)\n' "$status" >&2
  sed -n '1,80p' "$run_log" >&2
  rm -f "$last_message" "$run_log"
  return "$status"
}

case $agent in
  both)
    status=0
    run_claude || status=$?
    run_codex || status=$?
    exit "$status"
    ;;
  claude)
    run_claude
    ;;
  codex)
    run_codex
    ;;
  *)
    printf 'usage: %s [both|claude|codex]\n' "$0" >&2
    exit 2
    ;;
esac
