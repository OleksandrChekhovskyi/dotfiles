#!/bin/sh
set -eu

show_usage() {
    cat <<'EOF'
Usage: test-terminal-colors [--basic|--256|--all]

  --basic  Show the standard 16 terminal colors (default)
  --256    Show the 256-color palette grid
  --all    Show both views
EOF
}

show_color_labels() {
    color_base=$1
    shift
    i=0
    for label do
        printf '\033[%sm %-14s \033[0m' "$((color_base + i))" "$label"
        i=$((i + 1))
        [ $((i % 4)) -ne 0 ] || printf '\n'
    done
}

show_basic() {
    printf '16-color palette:\n'
    show_color_labels 30 black red green yellow blue magenta cyan white
    show_color_labels 90 \
        bright-black bright-red bright-green bright-yellow \
        bright-blue bright-magenta bright-cyan bright-white

    printf '\nForeground/background combinations:\n'
    show_combo_row "normal bg" 40 30
    show_combo_row "bright bg" 100 90
}

contrast_foreground() {
    i=$1

    if [ "$i" -lt 16 ]; then
        case $i in
            2 | 3 | 6 | 7 | 10 | 11 | 14 | 15) contrast_fg=0 ;;
            *) contrast_fg=15 ;;
        esac
    elif [ "$i" -lt 232 ]; then
        r=$(((i - 16) / 36))
        g=$(((i - 16) / 6 % 6))
        b=$(((i - 16) % 6))
        [ "$r" -eq 0 ] || r=$((55 + r * 40))
        [ "$g" -eq 0 ] || g=$((55 + g * 40))
        [ "$b" -eq 0 ] || b=$((55 + b * 40))
        if [ $((299 * r + 587 * g + 114 * b)) -ge 128000 ]; then
            contrast_fg=0
        else
            contrast_fg=15
        fi
    elif [ "$i" -ge 244 ]; then
        contrast_fg=0
    else
        contrast_fg=15
    fi
}

show_256() {
    printf '256-color palette (foregrounds on default background):\n'
    i=0
    while [ "$i" -le 255 ]; do
        printf '\033[38;5;%sm%3s\033[0m ' "$i" "$i"
        i=$((i + 1))
        [ $((i % 16)) -ne 0 ] || printf '\n'
    done

    printf '\n256-color palette (backgrounds):\n'
    i=0
    while [ "$i" -le 255 ]; do
        contrast_foreground "$i"
        printf '\033[48;5;%s;38;5;%sm%3s\033[0m ' "$i" "$contrast_fg" "$i"
        i=$((i + 1))
        [ $((i % 16)) -ne 0 ] || printf '\n'
    done
}

show_combo_row() {
    title=$1
    bg_base=$2
    fg_base=$3

    printf '%-10s ' "$title"
    i=0
    for label in black red green yellow blue magenta cyan white; do
        case $i in
            0 | 1 | 4 | 5) readable_fg=37 ;;
            *) readable_fg=30 ;;
        esac
        printf '\033[%s;%sm %-7s \033[0m' "$((bg_base + i))" "$readable_fg" "$label"
        i=$((i + 1))
    done
    printf '\n'

    printf '%-10s ' "matching"
    i=0
    for label in black red green yellow blue magenta cyan white; do
        printf '\033[%s;%sm %-7s \033[0m' "$((bg_base + i))" "$((fg_base + i))" "$label"
        i=$((i + 1))
    done
    printf '\n'
}

mode=${1:-"--basic"}

case $mode in
    --basic)
        show_basic
        ;;
    --256)
        show_256
        ;;
    --all)
        show_basic
        printf '\n'
        show_256
        ;;
    -h | --help)
        show_usage
        ;;
    *)
        show_usage >&2
        exit 1
        ;;
esac
