#!/usr/bin/env bash
set -euo pipefail

show_usage() {
    cat <<'EOF'
Usage: test-terminal-colors [--basic|--256|--all]

  --basic  Show the standard 16 terminal colors (default)
  --256    Show the 256-color palette grid
  --all    Show both views
EOF
}

show_basic() {
    local normal_labels=(black red green yellow blue magenta cyan white)
    local bright_labels=(
        bright-black bright-red bright-green bright-yellow
        bright-blue bright-magenta bright-cyan bright-white
    )
    local i

    printf '16-color palette:\n'
    for i in "${!normal_labels[@]}"; do
        printf '\033[%sm %-14s \033[0m' "$((30 + i))" "${normal_labels[$i]}"
        (( (i + 1) % 4 == 0 )) && printf '\n'
    done

    for i in "${!bright_labels[@]}"; do
        printf '\033[%sm %-14s \033[0m' "$((90 + i))" "${bright_labels[$i]}"
        (( (i + 1) % 4 == 0 )) && printf '\n'
    done

    printf '\nForeground/background combinations:\n'
    show_combo_row "normal bg" 40 30
    show_combo_row "bright bg" 100 90
}

contrast_foreground() {
    local i="$1"
    local r g b

    if (( i < 16 )); then
        case "$i" in
            2|3|6|7|10|11|14|15) contrast_fg=0 ;;
            *) contrast_fg=15 ;;
        esac
    elif (( i < 232 )); then
        r=$(( (i - 16) / 36 ))
        g=$(( (i - 16) / 6 % 6 ))
        b=$(( (i - 16) % 6 ))
        r=$(( r == 0 ? 0 : 55 + r * 40 ))
        g=$(( g == 0 ? 0 : 55 + g * 40 ))
        b=$(( b == 0 ? 0 : 55 + b * 40 ))
        (( 299 * r + 587 * g + 114 * b >= 128000 )) && contrast_fg=0 || contrast_fg=15
    else
        (( i >= 244 )) && contrast_fg=0 || contrast_fg=15
    fi
}

show_256() {
    local i

    printf '256-color palette (foregrounds on default background):\n'
    for i in {0..255}; do
        printf '\033[38;5;%sm%3s\033[0m ' "$i" "$i"
        (( (i + 1) % 16 == 0 )) && printf '\n'
    done

    printf '\n256-color palette (backgrounds):\n'
    for i in {0..255}; do
        contrast_foreground "$i"
        printf '\033[48;5;%s;38;5;%sm%3s\033[0m ' "$i" "$contrast_fg" "$i"
        (( (i + 1) % 16 == 0 )) && printf '\n'
    done
}

show_combo_row() {
    local title="$1"
    local bg_base="$2"
    local fg_base="$3"
    local labels=(black red green yellow blue magenta cyan white)
    local readable_fgs=(37 37 30 30 37 37 30 30)
    local i

    printf '%-10s ' "$title"
    for i in "${!labels[@]}"; do
        printf '\033[%s;%sm %-7s \033[0m' "$((bg_base + i))" "${readable_fgs[$i]}" "${labels[$i]}"
    done
    printf '\n'

    printf '%-10s ' "matching"
    for i in "${!labels[@]}"; do
        printf '\033[%s;%sm %-7s \033[0m' "$((bg_base + i))" "$((fg_base + i))" "${labels[$i]}"
    done
    printf '\n'
}

mode="${1:---basic}"

case "$mode" in
    --basic)
        show_basic
        ;;
    --256)
        show_256
        ;;
    --all)
        show_basic
        printf '\n'
        show_256
        ;;
    -h|--help)
        show_usage
        ;;
    *)
        show_usage >&2
        exit 1
        ;;
esac
